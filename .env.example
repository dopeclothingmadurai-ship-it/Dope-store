# =============================================================================
# Dope Store — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must NEVER be committed.
#
# NEXT_PUBLIC_*  -> exposed to the browser (safe, non-secret).
# everything else -> server-only secrets. Never expose these to the client.
# =============================================================================

# --- Public site ------------------------------------------------------------
# Absolute base URL of the deployment (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (public) ------------------------------------------------------
# Project URL and anon (publishable) key — from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase (secret) ------------------------------------------------------
# Service-role key — bypasses RLS. Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Razorpay ---------------------------------------------------------------
# Powers online checkout. Optional until provided: with keys absent the pay
# step is disabled gracefully (nothing crashes). Add all three and checkout
# works with no code changes.
#   NEXT_PUBLIC_RAZORPAY_KEY_ID  Public key id (checkout widget + order create).
#   RAZORPAY_KEY_SECRET          Server secret (create order + verify signature).
#   RAZORPAY_WEBHOOK_SECRET      Webhook signing secret (order-creation backstop).
# Webhook URL to register in the Razorpay dashboard:
#   https://<your-domain>/api/webhooks/razorpay   (event: payment.captured)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---------------------------------------------------------
# Powers the single automated transactional email (order confirmation).
# Optional: with RESEND_API_KEY unset the email layer no-ops (and logs) so
# checkout is never blocked. Add all three and it works with no code changes.
#   RESEND_API_KEY  -> https://resend.com/api-keys
#   EMAIL_FROM      -> a verified sender, "Dope Store <orders@yourdomain.com>"
#   EMAIL_REPLY_TO  -> where customer replies go, "support@yourdomain.com"
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Dev-only owner auto-login (optional) -----------------------------------
# Enables GET /api/dev-login?secret=... to open a real owner session for local
# browser verification — no password typing. It is HARD-DISABLED in production
# (the route returns 404 whenever NODE_ENV=production) and stays inert unless
# DEV_LOGIN_SECRET is set. Leave both unset outside local development.
# DEV_LOGIN_SECRET=generate-a-long-random-string
# DEV_LOGIN_EMAIL=owner@example.com
